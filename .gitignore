# ============================================================
# BINGO Forex — .gitignore
# ============================================================

# ─── Java / Maven ───────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# Maven wrapper
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ─── Spring Boot ────────────────────────────────────────────
*.log
spring.log

# ─── Node.js / npm ──────────────────────────────────────────
frontend/node_modules/
frontend/.npm
frontend/.pnp
frontend/.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Vite / Frontend build output ───────────────────────────
# Keep dist/ so Spring Boot can find static assets after `npm run build`
# but ignore the TypeScript build cache
frontend/.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# ─── Environment & Secrets ──────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ─── IDEs ────────────────────────────────────────────────────
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# VS Code
.vscode/
*.code-workspace

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# ─── OS Files ────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Docker ──────────────────────────────────────────────────
# Ignore local docker data volumes
docker/data/

# ─── Antigravity / AI assistant ──────────────────────────────
.gemini/
